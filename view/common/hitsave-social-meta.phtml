<?php
/**
 * Open Graph + Twitter Card tags for link unfurling (Discord, Slack, tryunfurl, etc.).
 *
 * Laminas HeadMeta HTML-escapes colons in property/name keys (og&#x3A;title), which
 * many crawlers ignore. Emit literal og:/twitter: attributes.
 *
 * Omeka escapeHtmlAttr encodes spaces and URL punctuation (&#x20;, &#x3A;); use
 * standard htmlspecialchars for content= so unfurl parsers see plain text and URLs.
 *
 * Pass: title (required), description, url, image, type, site_name.
 */
$title = trim((string) ($title ?? ''));
if ($title === '') {
    return;
}

$description = trim((string) ($description ?? ''));
$url = trim((string) ($url ?? ''));
$image = trim((string) ($image ?? ''));
$type = (string) ($type ?? 'website');
$siteName = trim((string) ($site_name ?? ''));

$esc = static function (string $value): string {
    return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
};

$og = static function (string $property, string $content) use ($esc): string {
    return '<meta property="' . $property . '" content="' . $esc($content) . '">' . "\n";
};
$tw = static function (string $name, string $content) use ($esc): string {
    return '<meta name="' . $name . '" content="' . $esc($content) . '">' . "\n";
};

$tags = $og('og:title', $title);
$tags .= $og('og:type', $type);
$tags .= $og('og:locale', 'en_US');
if ($siteName !== '') {
    $tags .= $og('og:site_name', $siteName);
}
if ($description !== '') {
    $tags .= $og('og:description', $description);
}
if ($url !== '') {
    $tags .= $og('og:url', $url);
}
if ($image !== '') {
    $tags .= $og('og:image', $image);
}

$tags .= $tw('twitter:card', $image !== '' ? 'summary_large_image' : 'summary');
$tags .= $tw('twitter:title', $title);
if ($description !== '') {
    $tags .= $tw('twitter:description', $description);
}
if ($image !== '') {
    $tags .= $tw('twitter:image', $image);
}

$this->placeholder('hitsaveSocialMeta')->append($tags);
