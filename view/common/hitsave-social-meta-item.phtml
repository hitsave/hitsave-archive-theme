<?php
if (empty($item)) {
    return;
}

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

$origin = function (): string {
    $parts = parse_url((string) $this->serverUrl(true));
    $scheme = $parts['scheme'] ?? 'https';
    $host = $parts['host'] ?? 'localhost';
    $port = isset($parts['port']) ? ':' . $parts['port'] : '';

    return $scheme . '://' . $host . $port;
};

$toAbsolute = function (string $pathOrUrl) use ($origin): string {
    if ($pathOrUrl === '') {
        return '';
    }
    if (preg_match('#^https?://#i', $pathOrUrl)) {
        return $pathOrUrl;
    }

    return rtrim($origin(), '/') . '/' . ltrim($pathOrUrl, '/');
};

$isDefaultThumbnailUrl = static function (string $url): bool {
    return str_contains($url, '/thumbnails/default.') || str_contains($url, 'default.png');
};

$title = (string) $item->displayTitle(null, $valueLang);

$description = strip_tags((string) $item->displayDescription(null, $valueLang));
$description = preg_replace('/\s+/u', ' ', trim($description)) ?? '';

$ark = null;
foreach ($item->value('dcterms:identifier', ['all' => true]) as $value) {
    $v = (string) $value->value();
    if (str_starts_with($v, 'ark:/') || str_starts_with($v, 'ark:')) {
        $ark = $v;
        break;
    }
}
if ($ark !== null && !str_starts_with($ark, 'ark:/')) {
    $ark = preg_replace('#^ark:#', 'ark:/', $ark, 1);
}

if ($description === '') {
    $description = $ark
        ? sprintf('Catalog record %s in the Hit Save! Archive.', $ark)
        : 'Press and marketing materials in the Hit Save! Archive.';
}

if (mb_strlen($description) < 120) {
    $lead = rtrim($description, '.');
    $description = sprintf(
        '%s. Browse flyers, scans, and packaging from the Hit Save! Archive — volunteer-preserved game history.%s',
        $lead,
        $ark ? ' Cite as ' . $ark . '.' : ''
    );
}

if (mb_strlen($description) > 300) {
    $description = mb_substr($description, 0, 297) . '…';
}

if ($ark) {
    $ogUrl = $toAbsolute('/' . $ark);
} else {
    $ogUrl = $toAbsolute((string) $item->siteUrl());
}

$ogImage = '';

foreach ($item->media() as $media) {
    if ($media->renderer() === 'omeka_dip_package') {
        $previewPath = $this->url(
            'omeka-dip-browse-preview',
            ['media_id' => (int) $media->id()],
            ['query' => ['type' => 'large']]
        );
        $ogImage = $toAbsolute((string) $previewPath);
        break;
    }
}

if ($ogImage === '' && $item->thumbnail()) {
    $thumbUrl = (string) $item->thumbnailUrl('large');
    if ($thumbUrl !== '' && !$isDefaultThumbnailUrl($thumbUrl)) {
        $ogImage = $toAbsolute($thumbUrl);
    }
}

if ($ogImage === '') {
    foreach ($item->media() as $media) {
        $mediaThumb = (string) $media->thumbnailUrl('large');
        if ($mediaThumb !== '' && !$isDefaultThumbnailUrl($mediaThumb)) {
            $ogImage = $toAbsolute($mediaThumb);
            break;
        }
    }
}

if ($ogImage === '') {
    $ogImage = $toAbsolute((string) $this->assetUrl('img/hit-save-wordmark.png'));
}

$siteName = (is_object($site ?? null) && method_exists($site, 'title'))
    ? (string) $site->title()
    : (string) $this->setting('installation_title', 'Hit Save! Archive');

$this->partial('common/hitsave-social-meta', [
    'title' => $title,
    'description' => $description,
    'url' => $ogUrl,
    'image' => $ogImage,
    'type' => 'article',
    'site_name' => $siteName,
]);
