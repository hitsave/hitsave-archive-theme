<?php
$this->headLink()->prependStylesheet($this->assetUrl('css/page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'page ' . $page->slug());

$homepage = $site->homepage();
$hubSlug = $this->themeSetting('hitsave_homepage_slug') ?: 'intro';
$isHomepage = ($homepage && (int) $homepage->id() === (int) $page->id()) || $page->slug() === $hubSlug;
$hideLegacyIntro = false;
if ($isHomepage) {
    $this->htmlElement('body')->appendAttribute('class', 'hitsave-homepage');
    $hideLegacySetting = $this->themeSetting('hitsave_hide_legacy_intro');
    $hideLegacyIntro = !in_array($hideLegacySetting, ['0', 0, false], true);
    if ($hideLegacyIntro) {
        $this->htmlElement('body')->appendAttribute('class', 'hitsave-hide-legacy-intro');
    }
}

if (!$isHomepage) {
    $this->pageTitle($page->title(), 2);
}

$showPagePagination = $this->siteSetting('show_page_pagination', true);
?>

<?php
$nav = $site->publicNav();
$container = $nav->getContainer();
$activePage = $nav->findActive($container);
if ($activePage && !$isHomepage):
?>
    <?php if ($activePage['depth'] !== 0): ?>
    <nav class="breadcrumbs"><?php echo $nav->breadcrumbs()->setPartial('common/foundation-breadcrumbs'); ?></nav>
    <?php endif; ?>
<?php endif; ?>

<?php if ($activePage && !$isHomepage): ?>
    <?php if ($this->displayNavigation && $activePage['page']->hasPages()): ?>
    <nav class="sub-menu wide" data-sticky-container>
        <div class="sticky" data-sticky data-anchor="blocks">
            <?php echo $nav->menu()->setUlClass('vertical menu')->renderSubMenu(); ?>
        </div>
    </nav>
    <?php endif; ?>
<?php endif; ?>

<?php $this->trigger('view.show.before'); ?>

<?php if ($isHomepage): ?>
    <?php echo $this->partial('common/hitsave-discovery-hub', ['site' => $site]); ?>
<?php endif; ?>

<?php if (!$hideLegacyIntro): ?>
<div id="blocks" class="blocks<?php echo $isHomepage ? ' hitsave-homepage-blocks' : ''; ?>">
    <?php echo $this->content; ?>
</div>
<?php endif; ?>
<?php $this->trigger('view.show.after'); ?>
<?php if ($showPagePagination && !$isHomepage): ?>
<?php echo $this->sitePagePagination(); ?>
<?php endif; ?>
